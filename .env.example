# ==============================================================================
# AI Job Intelligence - Environment Configuration Template
# Copy this file to .env and adjust variables for your local development environment.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Application Environment & Logging
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_intelligence_dev

# Scheduler Configuration (APScheduler)
SCHEDULER_ENABLED=false

# Provider-Agnostic LLM Gateway Credentials (Placeholders)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
